      <aliases enabled='yes' />
      <column caption='Discount Bin' datatype='string' name='[Calculation1 (copy)_99149574189719552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] = 0 &#10;THEN &apos;0%&apos; &#10;ELSEIF [Discount] &lt; 0.1 &#10;THEN &apos;0% - 10%&apos; &#10;ELSEIF [Discount] &lt; 0.2 &#10;THEN &apos;10% - 20%&apos;&#10;ELSEIF [Discount] &lt; 0.3 &#10;THEN &apos;20% - 30%&apos;&#10;ELSEIF [Discount] &lt; 0.4 &#10;THEN &apos;30% - 40%&apos;&#10;ELSEIF [Discount] &lt; 0.5&#10;THEN &apos;40% - 50%&apos;&#10;ELSEIF [Discount] &lt; 0.6&#10;THEN &apos;50% - 60%&apos;&#10;ELSE &apos;&gt; 60%&apos;&#10;&#10;END' />
      </column>
      <column caption='Global Profit (LOD)' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : SUM([Profit])}' />
      </column>
      <column caption='Profit Ratio ' datatype='real' name='[Calculation_44824902286520327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Profit]/[Sales]) * 100' />
      </column>
      <column caption='APAC Profit % Global' datatype='real' name='[Calculation_90072008614244352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Calculation1])' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Order Quarter' datatype='date' name='[Order Date (copy)_44824902278565888]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Order Date]' />
      </column>
      <column caption='Order Month' datatype='date' name='[Order Date (copy)_44824902280146947]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Order Date]' />
      </column>
      <column datatype='date' name='[Order Month (Months)]' role='dimension' type='quantitative' user:agg-type='Month-Trunc' user:base-field='Order Date (copy)_44824902280146947' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [Order Date (copy)_44824902280146947]))' />
      </column>
      <column datatype='date' name='[Order Quarter (Quarters)]' role='dimension' type='quantitative' user:agg-type='Quarter-Trunc' user:base-field='Order Date (copy)_44824902278565888' user:ui-builder='date-bin-builder'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;quarter&apos;, [Order Date (copy)_44824902278565888]))' />
      </column>
      <column datatype='string' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='nominal' />
